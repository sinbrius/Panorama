@model CategoryDtoForInsertion


<div class="text-center my-3">
    <div class="display-6">Kategori Ekleme</div>
</div>


<form method="Post" asp-action="Index">
    <div class="text-danger" asp-validation-summary="All"></div>

    <div class="form-group my-3">
        <label asp-for="KategoriAdı">Kategori İsmi</label>
        <input asp-for="KategoriAdı" class="form-control" placeholder="Kayseri Belediye Sınırı">
    </div>
    <div class="form-group my-3"></div>
        <div class="btn-group">
            <button class="btn btn-primary" type="submit">
                <i class="fas fa-solid fa-save"></i>
                Kaydet</button>
            <i class=""></i>
            <a asp-action="Index" class="btn btn-outline-primary">Geri Dön</a>

        </div>
    </div>
</form>
