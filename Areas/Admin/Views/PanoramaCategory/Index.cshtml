@model PanoramaCatDtoForInsertion


<div class="text-center my-3">
    <div class="display-6">Kategori Ekleme</div>
</div>

<form  asp-action="Index">
    <div class="form-group my-3">
        <label asp-for="PanoramaKategoriAdı">Kategori Adı </label>
        <input class="form-control" type="text" asp-for="PanoramaKategoriAdı" >
    </div>
    <div class="form-group my-3">
        <label asp-for="IlceId">Kategori Adı </label>
        <select class="form-control" asp-items="@ViewBag.Ilce" asp-for="IlceId"> </select>
    </div>

    <div class="form-group my-3"></div>
        <div class="btn-group">
            <button class="btn btn-primary" type="submit">
                <i class="fas fa-solid fa-save"></i>
                Save</button>
            <i class=""></i>
            <a asp-action="Index" class="btn btn-outline-primary">Back</a>

        </div>
    </div>

</form>

