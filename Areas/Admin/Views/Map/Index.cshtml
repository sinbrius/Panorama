@model IEnumerable<Harita>
@{
    Layout = "_Layout";
}
<div class="container-fluid col-12 my-3">
    <h3 class="text-center ">Harita Listesi</h3>
    
    <form method="get" asp-action="Index" asp-controller="Map" class="mb-3 d-flex justify-content-end">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control w-25 me-2"
            placeholder="Harita adı ara...">
        <button type="submit" class="btn btn-primary">Ara</button>
    </form>

    <table class="table ">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Harita Adı</th>
                <th>Dosya Türü</th>
                <th>Dosya Yolu</th>
                <th>Kategori</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Harita map in Model)
            {
                <tr>
                    <td>@map.HaritaId</td>
                    <td>@map.HaritaAdı</td>
                    <td>@map.DosyaTipi</td>
                    <td>@map.DosyaYolu</td>
                    <td>@map.Kategori?.KategoriAdı</td>
                    <td>
                        <div class="btn btn-group">
                            <a asp-action="Update" asp-controller="Map" class="btn btn-warning"
                                asp-route-id="@map.HaritaId">Güncelle</a>
                            <a asp-action="Delete" asp-controller="Map" asp-area="Admin" class="btn btn-danger"
                                asp-route-id="@map.HaritaId">Sil</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
