@model IEnumerable<Panorama>

<div class="container-fluid col-12 my-3">
    <h3 class="text-center ">Panorama Listesi</h3>
    
    <form method="get" asp-action="Index" asp-controller="Panorama" class="mb-3 d-flex justify-content-end">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control w-25 me-2"
            placeholder="Harita adı ara...">
        <button type="submit" class="btn btn-primary">Ara</button>
    </form>

    <table class="table ">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Panorama Adı</th>
                <th>Önizleme Yolu</th>
                <th>Dosya Yolu</th>
                <th>Kategori</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Panorama panorama in Model)
            {
                <tr>
                    <td>@panorama.PanoramaId</td>
                    <td>@panorama.PanoramaAd</td>
                    <td>@panorama.PanoramaResimYolu</td>
                    <td>@panorama.PanoramaYolu</td>
                    <td>@panorama.PanoramaKategori?.PanoramaKategoriAdı</td>
                    <td>
                        <div class="btn btn-group">
                            <a asp-action="Update" asp-controller="Panorama" class="btn btn-warning"
                                asp-route-id="@panorama.PanoramaId">Güncelle</a>
                            <a asp-action="Delete" asp-controller="Panorama" asp-area="Admin" class="btn btn-danger"
                                asp-route-id="@panorama.PanoramaId">Sil</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
